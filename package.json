{
    "name": "link-snapshot",
    "version": "1.0.0",
    "private": true,
    "description": "Paste URLs, capture full-page screenshots and optional HTML to a folder.",
    "license": "MIT",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win"
    },
    "dependencies": {
        "playwright": "^1.63.0",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2"
    },
    "devDependencies": {
        "electron": "^33.0.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.n3xt.linksnap",
        "productName": "LinkSnap",
        "directories": { "output": "dist" },
        "icon": "build/icon.png",
        "files": [
            "electron/**/*",
            "src/**/*",
            "ui/**/*",
            "build/icon.png",
            "package.json"
        ],
        "win": {
            "target": ["nsis", "portable"]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}
